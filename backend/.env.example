# Puerto de la API
PORT=4000

# Cadena de conexión de MongoDB Atlas (Connect > Drivers). Atlas ya funciona como replica set,
# requisito para las transacciones multidocumento (RQF-23 / Anexo B).
MONGO_URI="mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB=helpdesk_erp

# Secreto para firmar los JWT (pon una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA=8h

# Administrador inicial (RQF-04): solo se crea si no existe ningún administrador.
# Ojo: los valores con # deben ir entre comillas, si no dotenv los corta como comentario.
ADMIN_NOMBRE=Administrador General
ADMIN_CORREO=admin@helpdesk.local
ADMIN_PASSWORD="Admin#Helpdesk2026"
ADMIN_DOCUMENTO=1000000000

# Origen del frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Solo para desarrollo/sustentación: devuelve en la respuesta los tokens de verificación y
# recuperación (en producción irían únicamente por correo)
MOSTRAR_TOKENS_DEV=true
